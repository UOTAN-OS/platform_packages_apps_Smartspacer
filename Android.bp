java_library_static {
    name: "Smartspacer_viewbinding_stub",
    srcs: [
        "soong/src/main/java/**/*.java",
        "soong/src/main/java/**/*.kt",
    ],
    sdk_version: "current",
    min_sdk_version: "29",
}

android_library_import {
    name: "prebuilt_smartspacer_sdk_balloon",
    aars: [
        "prebuilts/m2/repository/com/github/skydoves/balloon/1.6.13/balloon-1.6.13.aar",
    ],
    sdk_version: "current",
    min_sdk_version: "29",
    static_libs: [
        "androidx.activity_activity-ktx",
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "androidx.fragment_fragment-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "kotlin-stdlib",
    ],
}

android_library {
    name: "Smartspacer_sdk-core",
    srcs: [
        "sdk-core/src/main/aidl/**/*.aidl",
        "sdk-core/src/main/java/**/*.java",
        "sdk-core/src/main/java/**/*.kt",
        "sdk-core/soong/**/*.java",
    ],
    manifest: "sdk-core/src/main/AndroidManifest.xml",
    aidl: {
        local_include_dirs: ["sdk-core/src/main/aidl"],
    },
    sdk_version: "current",
    min_sdk_version: "29",
    kotlin_plugins: ["kotlin-parcelize-compiler-plugin"],
    static_libs: [
        "androidx.core_core-ktx",
        "kotlin-parcelize-runtime",
    ],
}

android_library {
    name: "Smartspacer_sdk-client",
    srcs: [
        "sdk-client/src/main/aidl/**/*.aidl",
        "sdk-client/src/main/java/**/*.java",
        "sdk-client/src/main/java/**/*.kt",
        "sdk-client/soong/**/*.java",
        "sdk-client/soong/**/*.kt",
    ],
    manifest: "sdk-client/src/main/AndroidManifest.xml",
    resource_dirs: ["sdk-client/src/main/res"],
    aidl: {
        local_include_dirs: [
            "sdk-client/src/main/aidl",
            "sdk-core/src/main/aidl",
        ],
    },
    sdk_version: "current",
    min_sdk_version: "29",
    static_libs: [
        "Smartspacer_sdk-core",
        "Smartspacer_viewbinding_stub",
        "androidx-constraintlayout_constraintlayout",
        "androidx.core_core-ktx",
        "androidx.fragment_fragment-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-service",
        "kotlinx_coroutines",
        "prebuilt_smartspacer_sdk_balloon",
    ],
}
